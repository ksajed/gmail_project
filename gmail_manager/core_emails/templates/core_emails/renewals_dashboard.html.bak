{% load static %}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Renouvellements — Pharmacie</title>

  <!-- CSS -->
  <link rel="stylesheet" href="{% static 'css/dashboard.css' %}?v=500">
  <link rel="stylesheet" href="{% static 'css/modals.css' %}?v=500">
</head>
<body>
<div class="app">

  <!-- TOPBAR -->
  <div class="topbar">
    <div class="topbar__inner">
      <div class="titlewrap">
        <h1 class="page-title">Renouvellements — Pharmacie</h1>
        <div class="breadcrumb">Dashboard → Renouvellements</div>
      </div>

      <div class="btnrow">
        <div class="userchip" title="{{ request.user.get_full_name|default:request.user.username }}">
          <span class="avatar" aria-hidden="true">
            {{ request.user.get_full_name|default:request.user.username|slice:":1"|upper }}
          </span>
          <span> {{ request.user.get_full_name|default:request.user.username }} </span>
        </div>

        <a href="{% url 'core_emails:dashboard' %}" class="btn btn--soft-info">
          Retour au dashboard
        </a>

        <a href="{% url 'core_emails:sync_gmail_now' %}" class="btn btn--soft-info">
          <span class="ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M21 12a9 9 0 10-3 6.7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              <path d="M21 12v-6h-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          Synchroniser Gmail
        </a>

        <a href="{% url 'core_emails:logout' %}" class="btn btn--danger">
          <span class="ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M16 17l5-5-5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M21 12H9" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              <path d="M12 21H4a2 2 0 01-2-2V5a2 2 0 012-2h8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </span>
          Déconnexion
        </a>
      </div>
    </div>
  </div>

  <div class="container">

    <!-- ==========================
         RENOUVELLEMENTS À SURVEILLER
         ========================== -->
    <section class="card" style="margin-bottom:16px;">
      <div class="card__header">
        <h3 class="card__title">
          <span class="ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M12 8v4l3 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M21 12a9 9 0 11-9-9" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              <path d="M3 3v6h6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          Renouvellements à surveiller
        </h3>

        <div class="chips">
          <span class="chip">J-5: {{ renewals_due_5|length }}</span>
          <span class="chip">J-3: {{ renewals_due_3|length }}</span>
        </div>
      </div>

      <div class="card__body">
        <div style="color:var(--muted); font-weight:700; font-size:12px; margin-bottom:12px;">
          Calculés depuis la date du premier retrait (statut délivré).
        </div>

        <div style="font-weight:900; margin:10px 0;">Échéance dans 5 jours (J-5)</div>
        {% if renewals_due_5 %}
          <div class="tablewrap">
            <table>
              <thead>
              <tr>
                <th>Réf.</th>
                <th>Patient</th>
                <th>Date médecin</th>
                <th>Échéance</th>
                <th>Jours restants</th>
                <th>Action</th>
              </tr>
              </thead>
              <tbody>
              {% for p in renewals_due_5 %}
                <tr>
                  <td class="nowrap">#{{ p.id }}</td>
                  <td>
                    {% if p.patient %}
                      <div style="font-weight:900;">{{ p.patient.email }}</div>
                      {% if p.patient.full_name %}
                        <div style="color:var(--muted); font-weight:700; font-size:12px; margin-top:2px;">
                          {{ p.patient.full_name }}
                        </div>
                      {% endif %}
                    {% else %}
                      —
                    {% endif %}
                  </td>
                  <td class="nowrap">{{ p.established_at|date:"d/m/Y" }}</td>
                  <td class="nowrap">{{ p.renewal_end_date|date:"d/m/Y" }}</td>
                  <td class="nowrap">{{ p.renewal_days_left }}</td>
                  <td>
                    <div style="display:flex; gap:6px; flex-wrap:wrap;">
                      <form method="post" action="{% url 'core_emails:send_renewal_patient_email' p.id 5 %}" style="margin:0;">
                        {% csrf_token %}
                        <input type="hidden" name="next" value="{% url 'core_emails:renewals_dashboard' %}">
                        <button type="button" class="btn btn--sm btn--soft-info js-confirm-send" data-channel="EMAIL" data-days="5" data-prescription="{{ p.id }}">Email J-5</button>
                      </form>
                      <form method="post" action="{% url 'core_emails:send_renewal_patient_sms' p.id 5 %}" style="margin:0;">
                        {% csrf_token %}
                        <input type="hidden" name="next" value="{% url 'core_emails:renewals_dashboard' %}">
                        <button type="button" class="btn btn--sm btn--soft-info js-confirm-send" data-channel="SMS" data-days="5" data-prescription="{{ p.id }}">SMS J-5</button>
                      </form>
                      <a class="btn btn--sm" href="{% url 'core_emails:prescription_detail' p.id %}">Voir fiche</a>
                    </div>
                  </td>
                </tr>
              {% endfor %}
              </tbody>
            </table>
          </div>
        {% else %}
          <div class="hint">Aucun renouvellement J-5.</div>
        {% endif %}

        <div style="font-weight:900; margin:18px 0 10px;">Échéance dans 3 jours (J-3)</div>
        {% if renewals_due_3 %}
          <div class="tablewrap">
            <table>
              <thead>
              <tr>
                <th>Réf.</th>
                <th>Patient</th>
                <th>Date médecin</th>
                <th>Échéance</th>
                <th>Jours restants</th>
                <th>Action</th>
              </tr>
              </thead>
              <tbody>
              {% for p in renewals_due_3 %}
                <tr>
                  <td class="nowrap">#{{ p.id }}</td>
                  <td>
                    {% if p.patient %}
                      <div style="font-weight:900;">{{ p.patient.email }}</div>
                      {% if p.patient.full_name %}
                        <div style="color:var(--muted); font-weight:700; font-size:12px; margin-top:2px;">
                          {{ p.patient.full_name }}
                        </div>
                      {% endif %}
                    {% else %}
                      —
                    {% endif %}
                  </td>
                  <td class="nowrap">{{ p.established_at|date:"d/m/Y" }}</td>
                  <td class="nowrap">{{ p.renewal_end_date|date:"d/m/Y" }}</td>
                  <td class="nowrap">{{ p.renewal_days_left }}</td>
                  <td>
                    <div style="display:flex; gap:6px; flex-wrap:wrap;">
                      <form method="post" action="{% url 'core_emails:send_renewal_patient_email' p.id 3 %}" style="margin:0;">
                        {% csrf_token %}
                        <input type="hidden" name="next" value="{% url 'core_emails:renewals_dashboard' %}">
                        <button type="button" class="btn btn--sm btn--soft-info js-confirm-send" data-channel="EMAIL" data-days="3" data-prescription="{{ p.id }}">Email J-3</button>
                      </form>
                      <form method="post" action="{% url 'core_emails:send_renewal_patient_sms' p.id 3 %}" style="margin:0;">
                        {% csrf_token %}
                        <input type="hidden" name="next" value="{% url 'core_emails:renewals_dashboard' %}">
                        <button type="button" class="btn btn--sm btn--soft-info js-confirm-send" data-channel="SMS" data-days="3" data-prescription="{{ p.id }}">SMS J-3</button>
                      </form>
                      <a class="btn btn--sm" href="{% url 'core_emails:prescription_detail' p.id %}">Voir fiche</a>
                    </div>
                  </td>
                </tr>
              {% endfor %}
              </tbody>
            </table>
          </div>
        {% else %}
          <div class="hint">Aucun renouvellement J-3.</div>
        {% endif %}
      </div>
    </section>

    <!-- ==========================
         RENOUVELLEMENTS EN RETARD
         ========================== -->
    <section class="card">
      <div class="card__header">
        <h3 class="card__title">
          <span class="ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M12 9v4l3 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/>
            </svg>
          </span>
          Renouvellements en retard
        </h3>

        <div class="chips">
          <span class="chip chip--danger">Retard: {{ renewals_overdue|length }}</span>
        </div>
      </div>

      <div class="card__body">
        {% if renewals_overdue %}
          <div class="tablewrap">
            <table>
              <thead>
              <tr>
                <th>Réf.</th>
                <th>Patient</th>
                <th>Date médecin</th>
                <th>Échéance</th>
                <th>Jours restants</th>
                <th>Action</th>
              </tr>
              </thead>
              <tbody>
              {% for p in renewals_overdue %}
                <tr>
                  <td class="nowrap">#{{ p.id }}</td>
                  <td>
                    {% if p.patient %}
                      <div style="font-weight:900;">{{ p.patient.email }}</div>
                      {% if p.patient.full_name %}
                        <div style="color:var(--muted); font-weight:700; font-size:12px; margin-top:2px;">
                          {{ p.patient.full_name }}
                        </div>
                      {% endif %}
                    {% else %}
                      —
                    {% endif %}
                  </td>
                  <td class="nowrap">{{ p.established_at|date:"d/m/Y" }}</td>
                  <td class="nowrap">{{ p.renewal_end_date|date:"d/m/Y" }}</td>
                  <td class="nowrap">{{ p.renewal_days_left }}</td>
                  <td>
                    <div style="display:flex; gap:6px; flex-wrap:wrap;">
                      <form method="post" action="{% url 'core_emails:send_renewal_patient_email' p.id 0 %}" style="margin:0;">
                        {% csrf_token %}
                        <input type="hidden" name="next" value="{% url 'core_emails:renewals_dashboard' %}">
                        <button type="button" class="btn btn--sm btn--soft-info js-confirm-send" data-channel="EMAIL" data-days="0" data-prescription="{{ p.id }}">Email retard</button>
                      </form>
                      <form method="post" action="{% url 'core_emails:send_renewal_patient_sms' p.id 0 %}" style="margin:0;">
                        {% csrf_token %}
                        <input type="hidden" name="next" value="{% url 'core_emails:renewals_dashboard' %}">
                        <button type="button" class="btn btn--sm btn--soft-info js-confirm-send" data-channel="SMS" data-days="0" data-prescription="{{ p.id }}">SMS retard</button>
                      </form>
                      <a class="btn btn--sm" href="{% url 'core_emails:prescription_detail' p.id %}">Voir fiche</a>
                    </div>
                  </td>
                </tr>
              {% endfor %}
              </tbody>
            </table>
          </div>
        {% else %}
          <div class="hint">Aucun renouvellement en retard.</div>
        {% endif %}
      </div>
    </section>

  </div>
</div>

  <!-- RENEWALS_UNIFIED_MODAL:BEGIN -->
  <div id="renewalsModal" class="modal-overlay" role="dialog" aria-modal="true"
       aria-labelledby="renewalsModalTitle"
       style="display:none;"
       data-has-messages="{% if messages %}1{% else %}0{% endif %}">
    <div class="modal-card" style="width:min(760px, calc(100vw - 24px)); margin:auto;">
      <div class="modal-header" style="display:flex; align-items:center; justify-content:space-between;">
        <div id="renewalsModalTitle" style="font-weight:900;">Confirmation</div>
        <button type="button" class="btn" id="renewalsModalCloseBtn" aria-label="Fermer">Fermer</button>
      </div>

      <div class="modal-body" style="padding:14px 16px;">
        <div id="renewalsModalBody">
          <!-- contenu injecté via JS -->
        </div>

        <div id="renewalsModalActions" style="display:flex; gap:10px; justify-content:flex-end; margin-top:14px;">
          <button type="button" class="btn btn--primary" id="renewalsModalOkBtn">OK</button>
          <button type="button" class="btn" id="renewalsModalCancelBtn">Annuler</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    (function () {
      const modal = document.getElementById("renewalsModal");
      if (!modal) return;

      const titleEl = document.getElementById("renewalsModalTitle");
      const bodyEl = document.getElementById("renewalsModalBody");
      const actionsEl = document.getElementById("renewalsModalActions");
      const btnOk = document.getElementById("renewalsModalOkBtn");
      const btnCancel = document.getElementById("renewalsModalCancelBtn");
      const btnClose = document.getElementById("renewalsModalCloseBtn");

      let pendingForm = null;

      function openModal(title, html, withActions) {
        if (titleEl) titleEl.textContent = title || "Information";
        if (bodyEl) bodyEl.innerHTML = html || "";
        if (actionsEl) actionsEl.style.display = withActions ? "flex" : "none";
        modal.style.display = "flex";
      }

      function closeModal() {
        modal.style.display = "none";
        pendingForm = null;
      }

      // 1) Confirmation envoi Email/SMS
      document.addEventListener("click", function (e) {
        const btn = e.target.closest(".js-confirm-send");
        if (!btn) return;

        const form = btn.closest("form");
        if (!form) return;

        const channel = (btn.getAttribute("data-channel") || "ACTION").toUpperCase();
        const days = String(btn.getAttribute("data-days") || "");
        const pid = String(btn.getAttribute("data-prescription") || "");
        const when = (days === "0") ? "RETARD" : ("J-" + days);

        pendingForm = form;
        openModal(
          "Confirmation",
          `<div style="font-weight:900; margin-bottom:6px;">Confirmer l’envoi</div>
           <div>Envoyer <b>${channel}</b> au patient — Ordonnance #${pid} (${when}) ?</div>`,
          true
        );
      });

      if (btnOk) {
        btnOk.addEventListener("click", function () {
          if (pendingForm) pendingForm.submit();
          closeModal();
        });
      }
      if (btnCancel) btnCancel.addEventListener("click", closeModal);
      if (btnClose) btnClose.addEventListener("click", closeModal);

      modal.addEventListener("click", function (e) {
        if (e.target === modal) closeModal();
      });

      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && modal.style.display !== "none") closeModal();
      });

      // 2) Notifications Django messages => même modal, sans actions
      const hasMessages = (modal.getAttribute("data-has-messages") || "0") === "1";
      if (hasMessages) {
        const html = `
          <div style="font-weight:900; margin-bottom:10px;">Notifications</div>
          {% if messages %}
            {% for message in messages %}
              <div class="msg {% if message.tags %}msg--{{ message.tags }}{% endif %}"
                   style="padding:10px 12px; border:1px solid var(--border); border-radius:12px; background:#fff; margin-bottom:10px;">
                {{ message }}
              </div>
            {% endfor %}
          {% endif %}
        `;
        openModal("Notifications", html, false);
      }
    })();
  </script>
  <!-- RENEWALS_UNIFIED_MODAL:END -->

</body>
</html>
